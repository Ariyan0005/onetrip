[Unit]
Description=OneTrip widget API
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/onetripz.com
Environment=NODE_ENV=production
Environment=PORT=5000
ExecStart=/usr/bin/env pnpm --filter @workspace/api-server run start
Restart=always
RestartSec=5

# Create /etc/onetrip/onetrip-api.env with:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_PANEL_PASSWORD=
# SESSION_SECRET=
EnvironmentFile=-/etc/onetrip/onetrip-api.env

[Install]
WantedBy=multi-user.target